# Twelve Data — used for OHLC backtesting + bar fetching in live runner.
# Get a key at https://twelvedata.com/
TWELVEDATA_API_KEY=

# Ostium — used for on-chain order placement.
# Default network is Arbitrum Sepolia (testnet). Set OSTIUM_NETWORK=arbitrum
# AND OSTIUM_ALLOW_MAINNET=true to opt into mainnet.
OSTIUM_PRIVATE_KEY=
OSTIUM_RPC_URL=
OSTIUM_NETWORK=sepolia
OSTIUM_ALLOW_MAINNET=false

# Optional: where to write parquet cache.
DATA_CACHE_DIR=.cache/trading_bot
