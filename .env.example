# iTick — used for OHLC backtesting + bar fetching in the live runner.
# Generate a token in the iTick dashboard at https://itick.org and paste it
# here. The token is sent as the `token` request header.
#
# Free tier is capped at 5 requests / minute. The client throttles to one
# call per ~12s and retries with exponential backoff on errors.
ITICK_TOKEN=

# Ostium — used for on-chain order placement.
# Default network is Arbitrum Sepolia (testnet). Set OSTIUM_NETWORK=arbitrum
# AND OSTIUM_ALLOW_MAINNET=true to opt into mainnet.
OSTIUM_PRIVATE_KEY=
OSTIUM_RPC_URL=
OSTIUM_NETWORK=sepolia
OSTIUM_ALLOW_MAINNET=false

# Optional: where to write parquet cache.
DATA_CACHE_DIR=.cache/trading_bot
